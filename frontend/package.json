{
  "name": "terna-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "api:types": "npx --yes openapi-typescript@7.13.0 \"http://127.0.0.1:8080/api/schema/?format=json\" -o src/api/schema.d.ts && prettier --write src/api/schema.d.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4",
    "@tanstack/react-query": "^5.108.4",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "i18next": "^27.2.6",
    "i18next-browser-languagedetector": "^8.3.1",
    "lucide-react": "^1.79.0",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.3",
    "react-router": "^8.5.2",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "eslint": "^10",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.23.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8",
    "vite": "^8"
  },
  "engines": {
    "node": ">=24"
  }
}
