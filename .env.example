# Optional. Terna runs with no .env at all: every value below is already the default.
# Copy to .env and uncomment only what you want to change.
# Secrets (Django key, database, Redis, storage) are generated on first start by
# the secrets-init service and kept in the terna_secrets volume.

# Ports published on 127.0.0.1
# TERNA_HTTP_PORT=8080
# MAILPIT_UI_PORT=8025
# STORAGE_API_PORT=9000
# STORAGE_CONSOLE_PORT=9001

# Django
# DJANGO_DEBUG=false
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080
# LOG_LEVEL=INFO

# Workers
# WORKER_DEFAULT_CONCURRENCY=2
# WORKER_MEDIA_CONCURRENCY=1

# Object storage. Defaults to the bundled RustFS; point at any S3-compatible provider instead.
# STORAGE_ENDPOINT_URL=http://storage:9000
# STORAGE_PUBLIC_URL=http://localhost:9000
# STORAGE_BUCKET=terna
# STORAGE_REGION=us-east-1
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=

# Email. Defaults to the bundled Mailpit inbox; point at a real SMTP provider to send for real.
# EMAIL_HOST=mailpit
# EMAIL_PORT=1025
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=false
# DEFAULT_FROM_EMAIL=Terna <no-reply@terna.localhost>

# Public address of the app, used in links sent by email (verification, password reset).
# PUBLIC_APP_URL=http://localhost:8080
# Set to true when the app is served over HTTPS.
# AUTH_COOKIE_SECURE=false
